{
  "name": "@cerberauth/stubidp-playwright",
  "description": "Playwright helper to drive stubidp interaction UI in E2E tests",
  "version": "0.1.0",
  "author": "cerberauth",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cerberauth/stubidp-playwright.git"
  },
  "homepage": "https://github.com/cerberauth/stubidp-playwright",
  "bugs": {
    "url": "https://github.com/cerberauth/stubidp-playwright/issues"
  },
  "keywords": [
    "playwright",
    "oidc",
    "stubidp",
    "testing",
    "e2e"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test:e2e": "playwright test -c test/playwright.config.ts",
    "test:e2e:install": "playwright install --with-deps chromium",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0 <2"
  },
  "devDependencies": {
    "@cerberauth/stubidp": "^0.3.1",
    "@playwright/test": "^1.61.1",
    "@types/express": "^5",
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9",
    "express": "^5",
    "prettier": "^3",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^5"
  }
}
